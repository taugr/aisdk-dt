{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Asia/Yerevan',
  // Batch routine updates on Saturday mornings instead of opening daily PRs.
  schedule: ['* 0-8 * * 6'],
  labels: ['dependencies'],
  dependencyDashboard: true,
  prConcurrentLimit: 2,
  prHourlyLimit: 1,
  // Review grouped updates before merging; never silently merge a major.
  automerge: false,
  packageRules: [
    {
      description: 'Wait one day before updating npm packages',
      matchDatasources: ['npm'],
      minimumReleaseAge: '1 day',
      internalChecksFilter: 'strict',
    },
    {
      description: 'Let pnpm validate minimum release age for lockfile maintenance updates',
      matchDatasources: ['npm'],
      matchUpdateTypes: ['lockFileMaintenance'],
      minimumReleaseAge: null,
      prBodyNotes: [
        "Renovate's lock file maintenance updates are controlled by the package manager. Confirm pnpm's minimumReleaseAge validation before merging.",
      ],
    },
    {
      description: 'Renovate cannot currently validate minimum release age for package replacements',
      matchDatasources: ['npm'],
      matchUpdateTypes: ['replacement'],
      minimumReleaseAge: null,
      prBodyNotes: [
        "Renovate's package replacement updates cannot currently validate minimum release age. Manually confirm package age before merging.",
      ],
    },
    {
      description: 'Renovate cannot currently validate minimum release age for package pinning',
      matchDatasources: ['npm'],
      matchUpdateTypes: ['pin'],
      minimumReleaseAge: null,
      prBodyNotes: [
        "Renovate's package pinning updates cannot currently validate minimum release age. Manually confirm package age before merging.",
      ],
    },
    {
      description: 'Group routine non-major package, pnpm, and GitHub Actions updates',
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'weekly non-major dependencies',
      groupSlug: 'weekly-non-major',
    },
    {
      description: 'Create major update PRs only after dashboard approval',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],
  // Security fixes remain independent of the routine group and approval gate.
  vulnerabilityAlerts: {
    enabled: true,
    groupName: null,
    dependencyDashboardApproval: false,
    minimumReleaseAge: null,
    automerge: false,
  },
}
