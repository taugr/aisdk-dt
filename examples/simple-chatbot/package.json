{
  "name": "aisdk-dt-example-chatbot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev",
    "build": "next build --webpack",
    "start": "next start",
    "devtools": "pnpm exec devtools",
    "inspect:runs": "pnpm exec aisdk-dt runs --file .devtools/generations.json --limit 10 --pretty",
    "inspect:tools": "pnpm exec aisdk-dt tools --file .devtools/generations.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.1",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.0",
    "aisdk-dt": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
