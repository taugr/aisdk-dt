{
  "name": "aisdk-dt",
  "version": "0.1.2",
  "description": "CLI for querying AI SDK DevTools generations.json files.",
  "license": "MIT",
  "homepage": "https://github.com/taugr/aisdk-dt#readme",
  "bugs": {
    "url": "https://github.com/taugr/aisdk-dt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/aisdk-dt.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "ai-sdk",
    "ai-sdk-devtools",
    "devtools",
    "generations",
    "cli",
    "inspection"
  ],
  "bin": {
    "aisdk-dt": "dist/cli.js"
  },
  "files": [
    "dist",
    ".agents/skills/aisdk-dt-inspector/SKILL.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest --run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ai": "^6.0.168",
    "bumpp": "^11.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-llms": "^1.12.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
