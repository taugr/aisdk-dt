{
  "name": "aisdk-dt",
  "version": "0.1.3",
  "description": "CLI for querying AI SDK DevTools generations.json files.",
  "license": "MIT",
  "homepage": "https://github.com/taugr/aisdk-dt#readme",
  "bugs": {
    "url": "https://github.com/taugr/aisdk-dt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/aisdk-dt.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "ai-sdk",
    "ai-sdk-devtools",
    "devtools",
    "generations",
    "cli",
    "inspection"
  ],
  "bin": {
    "aisdk-dt": "dist/cli.js"
  },
  "files": [
    "dist",
    ".agents/skills/aisdk-dt-inspector/SKILL.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "format": "oxfmt . '!docs/.vitepress/cache/**' --check",
    "format:fix": "oxfmt . '!docs/.vitepress/cache/**' --write",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest --run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ai": "^7.0.29",
    "bumpp": "^11.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-llms": "^1.13.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
