{
  "name": "aisdk-dt",
  "version": "0.2.0",
  "description": "CLI for querying AI SDK DevTools generations.json files.",
  "license": "MIT",
  "homepage": "https://github.com/taugr/aisdk-dt#readme",
  "bugs": {
    "url": "https://github.com/taugr/aisdk-dt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/aisdk-dt.git"
  },
  "author": "Tom Auger <tom@tau.gr>",
  "keywords": [
    "ai-sdk",
    "ai-sdk-devtools",
    "devtools",
    "generations",
    "cli",
    "inspection"
  ],
  "bin": {
    "aisdk-dt": "dist/cli.js"
  },
  "files": [
    "dist",
    ".agents/skills/aisdk-dt-inspector/SKILL.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "format": "oxfmt . '!docs/.vitepress/cache/**' --check",
    "format:fix": "oxfmt . '!docs/.vitepress/cache/**' --write",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "corepack pnpm run build",
    "pretest": "corepack pnpm run build",
    "release": "bumpp",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "benchmark": "corepack pnpm run build && node scripts/benchmark.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ai": "^7.0.137",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
