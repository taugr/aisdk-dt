{
  "name": "aisdk-devtools-cli",
  "version": "0.1.0",
  "description": "CLI for querying AI SDK DevTools generations.json files.",
  "bin": {
    "aisdk-dt": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".agents/skills/aisdk-devtools-generations/SKILL.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ai": "^6.0.168",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
